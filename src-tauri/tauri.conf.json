{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Racore Browser",
  "version": "0.1.0",
  "identifier": "xyz.racore.browser",
  "build": {
    "beforeDevCommand": "npm run tauri:prepare && npm run desktop:ui:dev",
    "beforeBuildCommand": "npm run tauri:prepare && npm run desktop:ui",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Racore Browser",
        "width": 1480,
        "height": 940,
        "minWidth": 980,
        "minHeight": 680,
        "backgroundColor": "#090c10",
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; media-src https: http: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Racore",
    "copyright": "Copyright © 2026 Racore. All rights reserved.",
    "license": "LicenseRef-Racore-NonCommercial-1.0",
    "licenseFile": "licenses/INSTALLER-LICENSE.txt",
    "category": "Productivity",
    "shortDescription": "Private local-first agentic browser",
    "longDescription": "Racore Browser combines normal browsing, Racore Mesh domains, local AI planning, signed publishing, and IPFS in one private desktop workspace.",
    "externalBin": ["binaries/racored", "binaries/racore"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/nsis/header.bmp",
        "uninstallerHeaderImage": "windows/nsis/header.bmp",
        "sidebarImage": "windows/nsis/sidebar.bmp",
        "startMenuFolder": "Racore",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
